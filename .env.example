# ─────────────────────────────────────────────────────────────
# ARSENAL — variáveis de ambiente
# Copie para .env.local e preencha. .env.local NUNCA é commitado.
# ─────────────────────────────────────────────────────────────

# Groq — chat e transcrição (somente servidor). console.groq.com
# Não fornece embeddings: ver a nota em src/lib/ai/config.ts
GROQ_API_KEY=

# Supabase — cérebro (Postgres + pgvector + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: bypassa RLS. Só em scripts e rotas de servidor.
# Se isto vazar para o browser, o cofre inteiro está aberto.
SUPABASE_SERVICE_ROLE_KEY=

# Caminho absoluto do vault do Obsidian — usado apenas por scripts/sync-vault.ts
OBSIDIAN_VAULT_PATH=

# Site exibido na aba "Arsenal Secreto"
ARSENAL_SECRETO_URL=https://arsenalsecreto.lovable.app/
NEXT_PUBLIC_ARSENAL_SECRETO_URL=https://arsenalsecreto.lovable.app/

# ── Hotmart ────────────────────────────────────────────────────
# Token do postback (Ferramentas → Webhook → Hottok). O webhook recusa
# qualquer chamada sem ele, então sem essa variável nada é liberado.
HOTMART_HOTTOK=

# Produto: o ID casa o webhook com o slug interno do catálogo.
NEXT_PUBLIC_ARSENAL_HOTMART_PRODUCT_ID=
NEXT_PUBLIC_ARSENAL_CHECKOUT_URL=
NEXT_PUBLIC_ARSENAL_SALES_URL=https://arsenalsecreto.lovable.app/
# coming_soon esconde o checkout; troque para "live" no lançamento.
NEXT_PUBLIC_ARSENAL_PRODUCT_STATUS=coming_soon
