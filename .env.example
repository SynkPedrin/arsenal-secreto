# ─────────────────────────────────────────────────────────────
# ARSENAL — variáveis de ambiente
# Copie para .env.local e preencha. .env.local NUNCA é commitado.
# ─────────────────────────────────────────────────────────────

# OpenAI — motor de pensamento e embeddings (somente servidor/scripts)
OPENAI_API_KEY=

# Supabase — cérebro (Postgres + pgvector + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: bypassa RLS. Só em scripts e rotas de servidor.
# Se isto vazar para o browser, o cofre inteiro está aberto.
SUPABASE_SERVICE_ROLE_KEY=

# Caminho absoluto do vault do Obsidian — usado apenas por scripts/sync-vault.ts
OBSIDIAN_VAULT_PATH=

# Site exibido na aba "Arsenal Secreto"
ARSENAL_SECRETO_URL=https://arsenalsecreto.lovable.app/
NEXT_PUBLIC_ARSENAL_SECRETO_URL=https://arsenalsecreto.lovable.app/
